# MikroTik RouterOS Connection Parameters
# Primary REST API (HTTP / HTTPS) & Native Binary API Fallback (Port 8728 / 8729)

ROUTEROS_HOST=192.168.88.1
ROUTEROS_USER=admin
ROUTEROS_PASSWORD=your_secure_password_here

# REST API Settings
ROUTEROS_REST_PORT=443
ROUTEROS_USE_SSL=true

# Native Binary API Settings (Fallback)
ROUTEROS_API_PORT=8728
ROUTEROS_API_SSL_PORT=8729
ROUTEROS_PREFER_BINARY=false

# Operation Safety & Rollback Timeout (seconds)
ROUTEROS_WATCHDOG_TIMEOUT=30

# Multi-WAN & Routing Defaults (Vendor-Agnostic)
WAN_PRIMARY_TABLE=to_ISP1
WAN_SECONDARY_TABLE=to_ISP2
LOCAL_BYPASS_LIST=LOCAL_BYPASS
